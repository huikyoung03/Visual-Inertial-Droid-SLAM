# Copy outside this repository, edit paths, then: source /path/to/final_alpha750.env
export PYTHON=/absolute/path/to/python

# Prepared EuRoC V1_03 camera and rectified IMU assets.
export DATA_ROOT=/absolute/path/to/V1_03_difficult_droid_cam0
export IMU_PRIOR=/absolute/path/to/V1_03_difficult/imu_prior_rectified_fd_jacobian.csv
export GT_CSV=/absolute/path/to/V1_03_difficult/mav0/state_groundtruth_estimate0/data.csv

# Obtain droid.pth upstream and the selected alpha-750 checkpoint separately.
export ORIGINAL_WEIGHTS=/absolute/path/to/droid.pth
export LEARNED_WEIGHTS=/absolute/path/to/learned_cross_modal_alpha_localmatched_mh03_mh04_1k_000750.pth
export OUT_DIR=/absolute/path/to/new_v1_03_result

# Training only: MH_03/MH_04 raw EuRoC data and original-protocol manifests.
export TRAIN_DATA_ROOT=/absolute/path/to/euroc_stage3/raw
export MANIFEST_ROOT=/absolute/path/to/motion_filter_manifests_original_protocol
export BASE_CONFIDENCE_WEIGHTS=/absolute/path/to/learned_attenuation_rvp_quality_pretrain_joint2000_001000.pth
